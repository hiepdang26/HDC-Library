<?xml version="1.0" encoding="utf-8"?>
<!--
  Native dependencies of HDC ads, read by the External Dependency Manager.
  HDC > Ads > Enable writes this file, with {HDC_ROOT} replaced by where HDCLib is, to
  <HDCLib>/Editor/HDCAdsDependencies.xml, or to Assets/HDCAds/Editor/ when HDCLib is a package;
  Disable deletes it.
  Android: the library leaves Google Mobile Ads to the GMA Unity plugin and Meta Audience Network to its
  mediation package, so the game's versions are used. iOS: versions match what HDCAds was built with.
-->
<dependencies>
  <androidPackages>
    <repositories>
      <repository>{HDC_ROOT}/Plugins/Android/Repository~</repository>
    </repositories>
    <androidPackage spec="com.hdc.adsmultiplatform:hdc-ads-android:0.3.1" />
  </androidPackages>
  <iosPods>
    <iosPod name="Google-Mobile-Ads-SDK" version="~> 13.9" minTargetSdk="15.0" />
    <iosPod name="GoogleMobileAdsMediationFacebook" version="6.22.0.0" minTargetSdk="15.0" />
  </iosPods>
</dependencies>
